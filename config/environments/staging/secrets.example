# Staging Environment Secrets
# This file shows the structure of secrets needed for staging
# DO NOT COMMIT ACTUAL SECRETS TO THIS FILE!
# Use external secret management (Vault, AWS Secrets Manager, etc.)

# Database
DB_PASSWORD=your_secure_database_password_here

# Cache
REDIS_PASSWORD=your_secure_redis_password_here

# API Keys
API_KEY=your_api_key_here
JWT_SECRET=your_jwt_secret_here
ENCRYPTION_KEY=your_encryption_key_here

# External Services
STRIPE_SECRET_KEY=your_stripe_secret_key_here
AWS_ACCESS_KEY_ID=your_aws_access_key_here
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key_here
SENDGRID_API_KEY=your_sendgrid_api_key_here

# GitHub
GITHUB_TOKEN=your_github_token_here

# Docker Registry
DOCKER_USERNAME=your_docker_username_here
DOCKER_PASSWORD=your_docker_password_here

# Jenkins
JENKINS_USER=your_jenkins_username_here
JENKINS_TOKEN=your_jenkins_api_token_here

# Monitoring
MONITORING_API_KEY=your_monitoring_api_key_here

# SSL/TLS
SSL_CERTIFICATE=your_ssl_certificate_here
SSL_PRIVATE_KEY=your_ssl_private_key_here